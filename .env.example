# file-service 컨테이너 기동에 필요한 값 목록
#
#   cp .env.example .env
#   chmod 600 .env
#
# .env 는 저장소에 올리지 않음.
# AWS 액세스 키는 어디에도 적지 않음 → EC2 역할이 대신함.

# 프로파일. 서버에서는 prod 고정 (local 이면 디스크 저장)
SPRING_PROFILES_ACTIVE=prod

# 내 버킷 이름. 예 : cld01-files-20261013
APP_S3_BUCKET=

# 리전. 서울 고정
AWS_REGION=ap-northeast-2

# 이미지 선택. 공용 이미지를 그대로 씀 · <dockerhub_id> 는 수업에서 공유되는 Docker Hub 계정
DOCKERHUB_USER=<dockerhub_id>
APP_IMAGE_TAG=1.3.0

# 파일 목록 DB (RDS MySQL). user-data 가 Secrets Manager(RDS 관리형 비밀 rds!db-…)에서 역할로 읽어 채움. 손으로 적지 않음
DB_URL=jdbc:mysql://<rds_endpoint>:3306/files?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# 연결 풀 (선택 · 비우면 HikariCP 기본 최대 10 · 대기 30초). RDS max_connections 에 맞출 때 템플릿 .env 에 넣음
# SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=5
# SPRING_DATASOURCE_HIKARI_MINIMUMIDLE=2
# SPRING_DATASOURCE_HIKARI_CONNECTIONTIMEOUT=3000

# 목록 캐시 (ElastiCache Valkey 기본 엔드포인트 · 주소만, :6379 빼고) · 이벤트 표 (DynamoDB)
REDIS_HOST=<cache_endpoint>
REDIS_PORT=6379
APP_EVENTS_TABLE=<student_id>-file-events
